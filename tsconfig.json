{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist",
    "paths": {
      "../server/src/*": ["./server/src/*"]
    }
  },
  "include": ["api/**/*"],
  "exclude": ["node_modules", "client", "server/dist", "**/*.test.ts"]
}
