# Vercel 生产环境变量（在 Vercel Dashboard > Settings > Environment Variables 中设置）

# Supabase 数据库
# 从 Supabase Dashboard > Settings > Database > Connection string 获取
# 选择 "Transaction" 模式（端口 6543）用于 DATABASE_URL
DATABASE_URL="postgresql://postgres.项目ID:密码@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# 选择 "Session" 模式（端口 5432）用于 DIRECT_URL
DIRECT_URL="postgresql://postgres.项目ID:密码@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# JWT 密钥（生成命令见下）
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="生成的随机字符串"

# CORS（你的 Vercel 域名，部署后填写）
CORS_ORIGIN="https://你的项目名.vercel.app"

# 环境
NODE_ENV="production"
